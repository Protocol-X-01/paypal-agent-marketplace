# Local app URL
APP_URL=http://localhost:3000

# Channel3 product discovery. Keep this key server-side.
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
# Optional provider collection scope; shared catalog ID is public, not a key.
# Set this to the collection owned by the configured Channel3 account.
CHANNEL3_COLLECTION_ID=
CHANNEL3_COUNTRY=GB
CHANNEL3_CURRENCY=GBP
CHANNEL3_LANGUAGE=en
# Optional comma-separated exact HTTPS origins for a hosted Expo Web client.
# The localhost Expo dev origins are allowed only outside production.
MOBILE_WEB_ORIGINS=

# Required CoinGecko Demo API key; market data fails closed when it is unset.
COINGECKO_DEMO_API_KEY=

# PayPal sandbox integration values
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Server-only provider credentials used by optional integrations
OPENAI_API_KEY=
# Elastic OTLP HTTP base endpoint. Export stays disabled until this and the API key are set.
ELASTIC_OTLP_ENDPOINT=
# Elastic ingest key. Never expose this as a NEXT_PUBLIC variable.
ELASTIC_API_KEY=
KERNEL_API_KEY=
# The server instrumentation forces this on to avoid exporting fetch URLs or search queries.
NEXT_OTEL_FETCH_DISABLED=1
# Render account-management key for CLI/tooling only; never add it to the app service.
RENDER_API_KEY=

# Client-visible AG Grid Enterprise license for the business workspace.
NEXT_PUBLIC_AG_GRID_LICENSE=

# Customer sign-in is disabled until registered callbacks and durable storage are ready.
PAYPAL_LOGIN_ENABLED=false
# Web-only NEW sign-in admission acknowledgements; not automatic verification.
# Closing these does not invalidate existing sessions or disable logout/native gates.
PAYPAL_WEB_EDGE_CONTROLS_VERIFIED=false
PAYPAL_WEB_CALLBACK_REDACTION_VERIFIED=false
AUTH_PUBLIC_ORIGIN=
AUTH_SESSION_DATABASE_URL=
AUTH_SUBJECT_HMAC_KEY=
PAYPAL_LOGIN_ACCOUNT_ATTRIBUTES=false
# Native sign-in uses a separate callback and verified HTTPS app-return links.
# Verification flags are operator acknowledgements, not automatic verification.
PAYPAL_NATIVE_LOGIN_ENABLED=false
PAYPAL_NATIVE_LINKS_VERIFIED=false
PAYPAL_NATIVE_EDGE_CONTROLS_VERIFIED=false
AUTH_NATIVE_ANDROID_RETURN_URL=
AUTH_NATIVE_IOS_RETURN_URL=
