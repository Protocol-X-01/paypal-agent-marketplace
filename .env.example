# Local app URL
APP_URL=http://localhost:3000

# Channel3 product discovery. Keep this key server-side.
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
CHANNEL3_COUNTRY=US
CHANNEL3_CURRENCY=USD
CHANNEL3_LANGUAGE=en
# App-specific placeholder; Channel3's public browse API uses brand/category/retailer filters.
CHANNEL3_COLLECTION_ID=

# Optional CoinGecko Demo API key; keyless public requests are rate-limited.
COINGECKO_DEMO_API_KEY=

# PayPal sandbox integration values
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Other provider credentials used by optional integrations
OPENAI_API_KEY=
ELASTIC_API_KEY=
KERNEL_API_KEY=
# Render account-management key for CLI/tooling only; never add it to the app service.
RENDER_API_KEY=

# Client-visible AG Grid Enterprise license for the business workspace.
NEXT_PUBLIC_AG_GRID_LICENSE=
